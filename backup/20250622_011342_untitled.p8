pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init() //
	position_x=63
	position_y=63
	button=""
	
end

function _update()//every frame
	if btn(➡️) then
		position_x+=1
	end
	if btn(⬅️) then
		position_x-=1
	end
	if btn(⬇️) then
		position_y+=1
	end
	if btn(⬆️) then
		position_y-=1
	end
end

function _draw()
	cls()
	spr(1,position_x,position_y)
end
